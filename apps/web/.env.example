# Copy to .env and fill in. .env is gitignored.

# Auth — min 32-char random secret
BETTER_AUTH_SECRET=

# Database (MySQL DSN)
DATABASE_URL=mysql://user:password@localhost:3306/struxav2

# JWT keypair (PEM, newlines escaped as \n)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# 64-char hex string used for at-rest encryption
DATABASE_ENCRYPTION_KEY=

# Public URL of the app
APP_URL=http://localhost:3001

# Object storage (MinIO / S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=struxa

# --- Extension system ---
# Directory where installed extension packages are stored. In dev this is
# resolved relative to the next dev cwd (apps/web); in Docker use /data/extensions
# backed by a persistent volume.
EXTENSIONS_DIR=./.extensions
# Marketplace registry base URL and its ed25519 public key (base64 SPKI DER),
# produced by the registry's `npm run gen-keys`. Leave blank to disable the
# marketplace.
EXTENSIONS_REGISTRY_URL=http://localhost:4000
EXTENSIONS_REGISTRY_PUBLIC_KEY=
